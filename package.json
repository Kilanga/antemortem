{
  "name": "antemortem",
  "version": "0.1.0",
  "description": "Antemortem writes your post-mortems before the incidents happen — Atlassian Forge app (Codegeist 2026)",
  "main": "index.js",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "build:ui": "npm --prefix static/command-center run build",
    "install:ui": "npm --prefix static/command-center install",
    "deploy:dev": "npm run build:ui && forge deploy --non-interactive -e development --approve MAJOR_VERSION_RULE",
    "lint": "forge lint"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0"
  },
  "dependencies": {
    "@forge/api": "^8.4.0",
    "@forge/events": "^3.0.9",
    "@forge/kvs": "^2.1.1",
    "@forge/resolver": "^2.0.2",
    "@forge/sql": "^4.0.9"
  }
}
